# Envia somente a pasta Assets/Project (código e assets do jogo).
# Todo o resto do projeto Unity fica de fora.

# Ignora tudo na raiz...
/*

# ...menos os arquivos de configuração do Git
!/.gitignore
!/.gitattributes

# ...e a pasta Assets, mas só a subpasta Project dentro dela
!/Assets
/Assets/*
!/Assets/Project

# Todos os .meta (continuam no disco, só não vão para o Git)
*.meta

# Arquivos do sistema operacional
.DS_Store
Thumbs.db
desktop.ini
